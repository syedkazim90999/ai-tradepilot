# AI TradePilot — environment (copy to .env and fill in; NEVER commit .env)
# Backend reads backend/.env; Docker Compose reads the project-root .env
# (same variables — keep one copy at the project root for deploys).
# Database — PostgreSQL is the deployment target.
#   Local dev without Postgres: sqlite+aiosqlite:///./tradepilot.db
DATABASE_URL=postgresql+psycopg://tradepilot:tradepilot@localhost:5432/tradepilot
# Postgres service credentials (used by docker-compose.yml)
POSTGRES_USER=tradepilot
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=tradepilot
# Redis (Celery broker) — optional locally; the app falls back to an in-app asyncio worker.
REDIS_URL=redis://localhost:6379/0
# JWT signing secret — generate a long random value.
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
# JWT lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key for Binance API key encryption — generate with:
#   python scripts/generate_fernet_key.py
FERNET_KEY=
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Frontend -> backend URL (baked into the frontend Docker image at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Binance — Testnet is the default. Production requires explicit admin activation.
BINANCE_TESTNET_BASE_URL=https://testnet.binancefuture.com
BINANCE_TESTNET_WS_URL=wss://stream.binancefuture.com
BINANCE_PROD_BASE_URL=https://fapi.binance.com
BINANCE_PROD_WS_URL=wss://fstream.binance.com
BINANCE_USE_TESTNET=true
# Risk defaults (conservative Testnet defaults)
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=2.0
MAX_POSITIONS=5
MAX_LEVERAGE=2
REWARD_RISK_RATIO=2.0
ENVIRONMENT=development
DEBUG=false
# Email (NOT wired yet — verification/reset tokens are returned in dev responses.
# Fill these in when SMTP is added; see SECURITY.md.)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# Live trading is controlled in the DB by the Super Admin, NOT by an env var.
# Do NOT add LIVE_TRADING_ENABLED=true to .env unless you have read
# SECURITY.md and scripts/deploy-prod.sh refuses it without --confirm-live.
